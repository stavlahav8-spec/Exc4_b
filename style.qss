QMainWindow {
    background-color: #f3f7f8;
}

QWidget {
    color: #23343b;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

QLabel#pageTitle {
    color: #18343e;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #71838a;
    font-size: 10.5pt;
}

QFrame#chartCard {
    background-color: #ffffff;
    border: 1px solid #e2eaed;
    border-radius: 14px;
}

QLabel#chartTitle {
    color: #29444d;
    font-size: 12pt;
    font-weight: 600;
}

QPushButton {
    min-height: 38px;
    padding: 0 18px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton#primaryButton {
    color: #ffffff;
    background-color: #347f8a;
}

QPushButton#primaryButton:hover {
    background-color: #286d77;
}

QPushButton#primaryButton:pressed {
    background-color: #205a63;
}

QPushButton#secondaryButton {
    color: #347f8a;
    background-color: #e6f1f2;
}

QPushButton#secondaryButton:hover {
    background-color: #d7e9eb;
}

QPushButton#secondaryButton:pressed {
    background-color: #c8dfe2;
}

QToolBar {
    spacing: 6px;
    padding: 6px;
    border: 1px solid #dce7ea;
    border-radius: 10px;
    background-color: #f6fafb;
}

QToolBar QToolButton {
    min-width: 64px;
    min-height: 54px;
    padding: 6px 8px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #36515a;
    background-color: #ffffff;
    font-size: 9pt;
    font-weight: 600;
}

QToolBar QToolButton:hover {
    background-color: #e6f1f2;
    border-color: #c3d9dd;
}

QToolBar QToolButton:checked {
    color: #205a63;
    background-color: #d6e9eb;
    border-color: #9fc4c9;
}

QToolBar QToolButton:checked:hover {
    background-color: #c8dfe2;
}

QToolBar QToolButton:pressed {
    background-color: #c8dfe2;
}

QToolBar QToolButton:disabled {
    color: #9aabad;
    background-color: #f0f4f5;
}

QToolBar::separator {
    width: 1px;
    margin: 4px 2px;
    background-color: #dce7ea;
}
